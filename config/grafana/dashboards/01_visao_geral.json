    "datasource": {
     "type": "influxdb",
     "uid": "influx-fabrica"
    },
    "enable": true,
    "iconColor": "#F4AB1C",
    "name": "Cenários injetados",
    "target": {
     "refId": "Anno",
     "query": "from(bucket: \"fabrica\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"cenario\" and r._field == \"ativo\" or r._field == \"rotulo\" or r._field == \"texto\")\n  |> pivot(rowKey: [\"_time\", \"nome\", \"maquina\"], columnKey: [\"_field\"], valueColumn: \"_value\")\n  |> filter(fn: (r) => r.ativo == 1.0)\n  |> keep(columns: [\"_time\", \"rotulo\", \"texto\", \"nome\"])"
    },
    "mappings": {
     "title": {
      "source": "field",
      "value": "rotulo"
     },
     "text": {
      "source": "field",
      "value": "texto"
     },
     "tags": {
      "source": "field",
      "value": "nome"
     }
    }
   }
  ]
 },
 "templating": {
  "list": []
 },
 "panels": [
  {
   "id": 1,
   "type": "stat",
   "title": "Leituras boas (últimos 2 min)",
   "description": "Percentual de leituras que o gateway marcou como 'boa'.",
   "datasource": {
    "type": "influxdb",
    "uid": "influx-fabrica"
   },
   "gridPos": {
    "x": 0,
    "y": 0,
    "w": 5,
    "h": 4
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "influxdb",
      "uid": "influx-fabrica"
     },
     "query": "from(bucket: \"fabrica\")\n  |> range(start: -2m)\n  |> filter(fn: (r) => r._measurement == \"leitura\" and r._field == \"qualidade\")\n  |> map(fn: (r) => ({_time: r._time, _value: if r._value == \"boa\" then 100.0 else 0.0}))\n  |> group()\n  |> mean()"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "percent",
     "noValue": "sem dados",
     "color": {
      "mode": "thresholds"
     },
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       },
       {
        "color": "red",
        "value": 0
       },
       {
        "color": "orange",
        "value": 90
       },
       {
        "color": "green",
        "value": 98
       }
      ]
     },
     "decimals": 1
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ],
     "fields": "",
     "values": false
    },
    "colorMode": "background",
    "graphMode": "area",
    "textMode": "value",
    "justifyMode": "center"
   }
  },
  {
   "id": 2,
