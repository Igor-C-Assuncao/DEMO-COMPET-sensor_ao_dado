  {
   "id": 4,
   "type": "table",
   "title": "Cenários de anomalia (injetados na simulação)",
   "description": "Em uma fábrica real ninguém avisa que há uma anomalia. Aqui a simulação mostra o que foi injetado, para comparar com o que os gráficos revelam.",
   "datasource": {
    "type": "influxdb",
    "uid": "influx-fabrica"
   },
   "gridPos": {
    "x": 13,
    "y": 0,
    "w": 11,
    "h": 8
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "influxdb",
      "uid": "influx-fabrica"
     },
     "query": "from(bucket: \"fabrica\")\n  |> range(start: -6h)\n  |> filter(fn: (r) => r._measurement == \"cenario\")\n  |> pivot(rowKey: [\"_time\", \"nome\", \"maquina\"], columnKey: [\"_field\"], valueColumn: \"_value\")\n  |> group(columns: [\"nome\"])\n  |> sort(columns: [\"_time\"])\n  |> tail(n: 1)\n  |> group()\n  |> sort(columns: [\"ativo\", \"_time\"], desc: true)\n  |> keep(columns: [\"_time\", \"rotulo\", \"maquina\", \"ativo\"])"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "custom": {
      "align": "auto",
      "cellOptions": {
       "type": "auto"
      },
      "filterable": false
     },
     "color": {
      "mode": "thresholds"
     },
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       }
      ]
     }
    },
    "overrides": [
     {
      "matcher": {
       "id": "byName",
       "options": "ativo"
      },
      "properties": [
       {
        "id": "mappings",
        "value": [
         {
          "type": "value",
          "options": {
           "1": {
            "text": "ATIVO",
            "color": "red",
            "index": 0
           },
           "0": {
            "text": "encerrado",
            "color": "green",
            "index": 1
           }
          }
         }
        ]
       },
       {
        "id": "custom.cellOptions",
        "value": {
         "type": "color-text"
        }
       }
      ]
     },
     {
      "matcher": {
       "id": "byName",
       "options": "_time"
      },
      "properties": [
       {
        "id": "displayName",
        "value": "desde"
       }
      ]
     }
    ]
   },
   "options": {
    "showHeader": true,
    "cellHeight": "sm",
    "footer": {
     "show": false
    }
   },
   "transformations": []
  },
  {
   "id": 5,
   "type": "state-timeline",
   "title": "Máquinas ligadas",
   "description": "Contato de 'ligada' de cada máquina.",
   "datasource": {
    "type": "influxdb",
    "uid": "influx-fabrica"
   },
   "gridPos": {
    "x": 0,
    "y": 4,
    "w": 13,
    "h": 6
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "influxdb",
      "uid": "influx-fabrica"
     },
     "query": "passo = (int(v: v.timeRangeStop) - int(v: v.timeRangeStart)) / 700\njanela = if passo > 10000000000 then duration(v: passo) else duration(v: 10000000000)\n\nfrom(bucket: \"fabrica\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"leitura\" and r._field == \"valor\" and r.variavel == \"ligada\")\n  |> aggregateWindow(every: janela, fn: last, createEmpty: false)\n  |> group()\n  |> pivot(rowKey: [\"_time\"], columnKey: [\"maquina\"], valueColumn: \"_value\")\n  |> keep(columns: [\"_time\", \"prensa01\", \"laminadora01\", \"misturador02\", \"esteira04\"])"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "mappings": [
      {
       "type": "value",
       "options": {
        "1": {
         "text": "ligada",
         "color": "green",
         "index": 0
        },
        "0": {
         "text": "parada",
         "color": "red",
         "index": 1
        }
       }
      }
     ],
     "custom": {
      "fillOpacity": 80,
      "lineWidth": 0,
      "spanNulls": false
     },
     "color": {
      "mode": "fixed",
      "fixedColor": "green"
     },
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       }
      ]
     }
    },
    "overrides": []
   },
   "options": {
    "mergeValues": true,
    "showValue": "auto",
    "alignValue": "left",
    "rowHeight": 0.8,
    "legend": {
     "showLegend": true,
     "displayMode": "list",
     "placement": "bottom"
    },
    "tooltip": {
     "mode": "single"
    }
   }
  },
