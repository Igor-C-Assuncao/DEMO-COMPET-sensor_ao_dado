     },
     "query": "from(bucket: \"fabrica\")\n  |> range(start: -1m)\n  |> filter(fn: (r) => r._measurement == \"link\" and r._field == \"ok\")\n  |> group(columns: [\"maquina\", \"variavel\"])\n  |> last()\n  |> filter(fn: (r) => r._value == 0.0)\n  |> group()\n  |> count()"
